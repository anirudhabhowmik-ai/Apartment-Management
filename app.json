{
  "expo": {
    "name": "Apartment Management",
    "slug": "anirudhabhowmik",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "apartmentmanagement",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "This app needs access to photos to upload profile pictures and bill attachments.",
        "NSPhotoLibraryAddUsageDescription": "This app saves the gate QR code to your photo gallery so you can share it with visitors.",
        "NSCameraUsageDescription": "This app needs access to camera to take photos for profile pictures and bill attachments.",
        "NSContactsUsageDescription": "This app needs access to contacts to help you quickly add phone numbers."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.anirudhabhowmik.apartmentmanagement",
      "versionCode": 4,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "head": {
        "script": [
          {
            "src": "https://www.googletagmanager.com/gtag/js?id=AW-674352071",
            "async": true
          },
          {
            "content": "window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', 'AW-674352071');"
          }
        ]
      }
    },
    "plugins": [
      "./plugins/withPreviewArch",
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-status-bar",
      "expo-asset",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "minSdkVersion": 24,
            "targetSdkVersion": 36,
            "useLegacyPackaging": false,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload profile pictures and bill attachments.",
          "cameraPermission": "The app accesses your camera to let you take photos for profile pictures and bill attachments."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos so you can save the gate QR code.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save the gate QR code to your photo gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "The app accesses your contacts to help you quickly add phone numbers."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "playStoreBuild": true,
      "revenuecatGoogleApiKey": "goog_lbEQMPIHcXXLJOsvKpXEWanyrla",
      "revenuecatAppleApiKey": "appl_PLACEHOLDER",
      "eas": {
        "projectId": "fcbcf0b3-e22c-4620-a25d-53e8fc0ec627"
      }
    },
    "owner": "anirudhabhowmiks-team"
  }
}
